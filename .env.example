# ============================================================
# RIDEON SPINNING — Variables de entorno
# Copia este archivo a .env.local y llena los valores reales.
# ============================================================

# ---- Supabase ----
# Encuéntralos en Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ---- Stripe ----
# Stripe Dashboard → Developers → API keys
# Empieza con sk_test_ y pk_test_ en modo de prueba; en producción usa sk_live_ y pk_live_
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Webhook secret: se genera al crear el endpoint en Stripe Dashboard → Webhooks
# Apuntar al endpoint /api/webhooks/stripe en tu deploy
STRIPE_WEBHOOK_SECRET=whsec_...

# ---- Stripe Price IDs ----
# Crear los productos/precios en Stripe Dashboard → Products
# Llenar después; por ahora los pagos calculan amount_cents desde la BD
STRIPE_PRICE_ID_CLASE_SUELTA=
STRIPE_PRICE_ID_PACK_5=
STRIPE_PRICE_ID_MENSUALIDAD=

# ---- App ----
NEXT_PUBLIC_SITE_URL=https://rider-spinning.vercel.app

# ---- Resend (emails de confirmación) — opcional, fase posterior ----
RESEND_API_KEY=
EMAIL_FROM="Rideon <reservas@rideonspinning.com>"
