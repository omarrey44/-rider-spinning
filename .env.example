# ============================================================
# RIDEON SPINNING — Variables de entorno
# Copia este archivo a .env.local y llena los valores reales.
# Nunca commitees .env.local — está en .gitignore.
# ============================================================

# ---- Supabase ----
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ---- Stripe ----
# Developers → API keys
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Developers → Webhooks → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_...

# ---- App ----
# En local: http://localhost:3000
# En Vercel preview/prod: el deploy URL
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ---- Feedback (Quejas y Sugerencias) ----
# Resend: https://resend.com → API Keys
RESEND_API_KEY=re_...
# CallMeBot WhatsApp: regístrate en https://www.callmebot.com/blog/free-api-whatsapp-messages/
# Envía "I allow callmebot to send me messages" al número +34 644 85 39 65 en WhatsApp
# Recibirás tu apikey en respuesta
CALLMEBOT_API_KEY=123456
